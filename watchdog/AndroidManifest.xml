<?xml version="1.0" encoding="utf-8"?>
<!--
  «Сбер-Стоп NA» — сторож для SaluteTV AT30A6 (Android 13, StarOS) с лаунчером
  NA Clean Toour TV (com.gathin.tvhome). Собран без Gradle: см. build-linux.sh.

  Отличия от исходного io.sberstop 1.4 (Free My TV):
  * главный экран возвращается на com.gathin.tvhome/.MainActivity;
  * список пакетов — проверенный список владельца AT30A6 (20 пакетов, sberstop 1.4);
  * заставка переключается на com.gathin.tvhome/.ClockDream, пока в ней сидит Сбер;
  * добавлена QUERY_ALL_PACKAGES (список пакетов и вторая половина проверки);
  * на экране показывается ADB-ключ приложения (отпечаток) для авторизации на ТВ.

  Пакет и подпись намеренно оставлены от исходного сторожа (io.sberstop,
  sberstop.keystore): так APK ставится обновлением поверх старой версии, если она
  ещё есть на телевизоре. Если на ТВ стоит io.sberstop с другой подписью —
  сначала `adb uninstall io.sberstop`, см. README-NA.md.

  2.1-NA: добавлена служба доступности io.sberstop.CtvCloseWatcher — после ухода
  приложения «Цифровое ТВ» (limehd.ru.ctv) с переднего плана (или при выключении
  экрана) она очищает его кеш и данные через ADB (`pm clear limehd.ru.ctv`).
  Служба доступности НЕ требует доступа к содержимому окон и не получает новых
  разрешений; включается владельцем ТВ вручную, см. README-NA.md.

  2.2-NA: сторож универсальный. Blacklist.apply() перед любыми изменениями
  проверяет, что ТВ — Сбер-ТВ: установлены и сервисы Сбера (ru.sberdevices.services
  или ru.sberdevices.starlauncher), и лаунчер NA (com.gathin.tvhome). Иначе проход
  сразу возвращает «не Сбер-ТВ: Sber-очистка пропущена» и НИЧЕГО не меняет (Home,
  заставка, настройки, пакеты не трогаются). На не-Sber ТВ работает только служба
  доступности с очисткой ЦТВ. Дополнительно (2.2-NA) Adb.java может брать ключ из
  внешнего каталога приложения — adbkey/adbkey.pub, подложенные `adb push`.

  2.3-NA: добавлен фоновый сервис io.sberstop.CleanerService — очистка ЦТВ БЕЗ службы
  доступности, для ТВ, где прошивка (YAOS/Hartens) не даёт включить сторонний
  AccessibilityService. Сервис объявлен exported=true, поэтому запускается с ПК по
  adb без UI: `am start-foreground-service -n io.sberstop/.CleanerService`. Раз в ~2 с
  в фоновом потоке спрашивает активную активити через ADB и, если ЦТВ ушло с экрана,
  делает `pm clear limehd.ru.ctv` (антидребезг 3 с); при ACTION_SCREEN_OFF чистит,
  если ЦТВ было на экране. Low-importance уведомление, канал "cleaner". Автозапуск из
  BootReceiver (startForegroundService, при исключении — startService). Новых
  разрешений нет (FOREGROUND_SERVICE объявлен ещё в 2.1-NA).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.sberstop"
    android:versionCode="9"
    android:versionName="2.3-NA">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 11+. Список пакетов сторож берёт через ADB-shell (`pm list packages`), но
         разрешение объявляем, чтобы приложение видело установленные пакеты и без shell. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Сбер-Стоп NA"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Сбер-Стоп NA"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|fontScale|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Загрузка, обновление сторожа и сообщения об установке/включении приложений. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Фоновые проходы: JobScheduler, чтобы Android не блокировал запуск из фона. -->
        <service
            android:name=".KeeperJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Немедленный проход по кнопке «Проверить сейчас» (приложение на экране). -->
        <service
            android:name=".KeeperService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 2.3-NA: фоновая очистка ЦТВ БЕЗ службы доступности (для ТВ, где сторонний
             AccessibilityService включить нельзя). exported=true — сервис запускается с ПК по adb
             без UI: `am start-foreground-service -n io.sberstop/.CleanerService`. Работает как
             foreground service с low-importance уведомлением (канал "cleaner"), опрашивает активную
             активити через ADB раз в ~2 с и чистит ЦТВ после ухода с экрана / выключения экрана.
             Новых разрешений не требует: FOREGROUND_SERVICE объявлен выше. Кнопка «Проверить
             сейчас» этот сервис НЕ запускает. -->
        <service
            android:name=".CleanerService"
            android:exported="true"
            android:label="Сбер-Стоп NA: фоновая очистка ЦТВ"
            android:foregroundServiceType="dataSync" />

        <!-- 2.1-NA: служба доступности «очистка ЦТВ после закрытия». Новых разрешений не
             добавляет: событий смены активного окна хватает, содержимое окон не читается
             (canRetrieveWindowContent=false в res/xml/accessibility_service_config.xml).
             Включается владельцем ТВ вручную — Настройки → Специальные возможности, либо
             командами из README-NA.md. -->
        <service
            android:name=".CtvCloseWatcher"
            android:exported="true"
            android:label="Сбер-Стоп NA: очистка ЦТВ"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
